# ---------------------------------------------------------------------------
# competitive-tracker-web — environment template
#
# Copy to .env.local and fill in. NEVER commit .env.local (.gitignore covers
# .env*). Never paste real values into chat, email or a ticket.
#
# Each person working on this provisions their OWN credentials where the
# provider allows it. Shared secrets cannot be revoked per-person.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Both values below are PUBLIC — they ship in the browser bundle.
# Project settings → API. Shared across the team; not a secret.
#
# NOTE: these are only safe to expose while Row Level Security is enabled.
# See the RLS note in CLAUDE.md before treating them as harmless.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Must be the NEW publishable key (sb_publishable_...), not the legacy JWT
# anon key. The Python crawler in ../my-tracker uses the legacy one because
# supabase-py 2.0.2 rejects the new format.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Anthropic ------------------------------------------------------------
# Used by app/api/businesses/[id]/research/route.ts (competitor discovery).
# Provision your own key. If you need one against the project account, ask for
# a key scoped to its own Workspace with a spend limit — not the root key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- GitHub ---------------------------------------------------------------
# Fine-grained PAT. Triggers the crawler workflow via workflow_dispatch.
# Fine-grained PATs are per-user and CANNOT be shared — create your own:
#   Only select repositories → farrukhj91/pm-competitive-research-tracker
#   Permissions → Actions: Read and write
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx

# owner/repo of the crawler (where daily_crawl.yml lives) — not this repo.
GITHUB_REPO=farrukhj91/pm-competitive-research-tracker
